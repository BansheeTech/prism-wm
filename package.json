{
  "name": "@prism-wm/monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Prism Window Manager — a framework-agnostic desktop windowing system (AGPL-3.0)",
  "license": "AGPL-3.0-or-later",
  "author": "Banshee Technologies S.L.",
  "contributors": [
    {
      "name": "Claudio González",
      "url": "https://github.com/SurceBeats"
    },
    {
      "name": "Néstor González",
      "url": "https://github.com/Anghios"
    }
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BansheeTech/prism-wm.git"
  },
  "homepage": "https://www.banshee.pro",
  "packageManager": "pnpm@9.0.0",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "pnpm -r --filter \"./packages/*\" build",
    "typecheck": "pnpm -r --filter \"./packages/*\" typecheck",
    "test": "pnpm -r --filter \"./packages/*\" test",
    "clean": "pnpm -r exec rm -rf dist node_modules/.cache",
    "release": "pnpm typecheck && pnpm test && pnpm -r --filter \"./packages/*\" publish --access public"
  }
}
