{
  "name": "@prism-wm/svelte",
  "version": "1.0.0",
  "description": "Svelte adapter for the Prism Window Manager.",
  "license": "AGPL-3.0-or-later",
  "author": "Banshee Technologies S.L.",
  "contributors": [
    {
      "name": "Claudio González",
      "url": "https://github.com/SurceBeats"
    },
    {
      "name": "Néstor González",
      "url": "https://github.com/Anghios"
    }
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BansheeTech/prism-wm.git",
    "directory": "packages/svelte"
  },
  "homepage": "https://github.com/BansheeTech/prism-wm#readme",
  "bugs": {
    "url": "https://github.com/BansheeTech/prism-wm/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "svelte": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "peerDependencies": {
    "svelte": "^4.0.0 || ^5.0.0"
  },
  "dependencies": {
    "@prism-wm/core": "workspace:*",
    "@prism-wm/styles": "workspace:*"
  },
  "scripts": {
    "build": "svelte-package --input src --output dist",
    "typecheck": "svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "prepack": "pnpm run build && cp ../../LICENSE ."
  },
  "devDependencies": {
    "svelte": "^5.0.0",
    "@sveltejs/package": "^2.3.0",
    "@sveltejs/vite-plugin-svelte": "^4.0.0",
    "@testing-library/svelte": "^5.2.0",
    "@testing-library/dom": "^10.4.0",
    "svelte-check": "^4.0.0",
    "typescript": "^5.5.0",
    "vite": "^5.3.0",
    "happy-dom": "^15.0.0",
    "vitest": "^2.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
